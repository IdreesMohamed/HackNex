# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_WS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Sarvam (primary) ---
SARVAM_API_KEY=
SARVAM_ASR_URL=wss://api.sarvam.ai/speech-to-text-realtime/ws
SARVAM_ASR_MODEL=saaras:v3-realtime
SARVAM_TRANSLATE_URL=https://api.sarvam.ai/translate
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech

# --- Azure (fallback) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# --- Data ---
DATABASE_URL=postgresql+asyncpg://bhasha:bhasha@postgres:5432/bhashalive
REDIS_URL=redis://redis:6379/0

# --- Monitoring ---
SENTRY_DSN=

# --- Feature flags ---
ENABLE_FALLBACK=true
ENABLE_PERSISTENCE=true
ENABLE_TTS=false
ENABLE_GLOSSARY=true
ENABLE_TWO_WAY=false
STORE_RAW_AUDIO=false

# --- Stability scheduler defaults ---
STAB_K=3
STAB_MIN_WORDS=3
STAB_COMMIT_WORDS=6
STAB_DEBOUNCE_MS=300
STAB_MAX_WAIT_MS=1500
SCHEDULER_MODE=adaptive

# --- Limits ---
RATE_LIMIT_SESSIONS_PER_MIN=10
MAX_SESSION_SECONDS=1800
MAX_AUDIO_CHUNK_BYTES=65536
